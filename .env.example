# Example only. Copy into a secret manager; never commit real values.
MC_ACCEPTANCE_MODE=true
# Replace with the actual dedicated acceptance origin before registering OAuth/UAT.
MC_ORIGIN=https://pruebas.micontacto.online
MC_BIND_HOST=0.0.0.0
PORT=3000
MC_SESSION_SECRET=
MC_DATABASE_URL=
MC_DATABASE_ISOLATED=true
MC_DATABASE_TLS=true
MC_DATABASE_CA=
MC_GOOGLE_CLIENT_ID=
MC_GOOGLE_CLIENT_SECRET=
MC_STORAGE=r2
MC_R2_ACCOUNT_ID=
MC_R2_ACCESS_KEY_ID=
MC_R2_SECRET_ACCESS_KEY=
MC_R2_BUCKET=
MC_R2_ISOLATED=true
# Optional private-volume alternative to R2:
MC_PHOTO_ROOT=/var/lib/mi-contacto/photos
# Default off. Test credentials only; production payments unsupported.
MC_YAPPY_SANDBOX_ENABLED=false
MC_YAPPY_ENVIRONMENT=test
MC_YAPPY_MERCHANT_ID=
MC_YAPPY_SECRET=
MC_YAPPY_ISOLATED=true
# Default off. Requires dedicated verified sender and explicit test recipients.
MC_EMAIL_TEST_ENABLED=false
MC_RESEND_API_KEY=
MC_EMAIL_FROM=comprobantes@mail.micontacto.online
MC_EMAIL_TEST_RECIPIENTS=
MC_EMAIL_ISOLATED=true
